<!-- - - - - - - - - - - -  -->
<!--	Experimental Data Sources for jose	-->
<!-- - - - - - - - - - - -  -->
<data-sources>
	<data-source default="false">
		<display-name> MySQL-aws </display-name>
		<jndi-name> jdbc/mysql-aws </jndi-name>
		<!-- runs MySQL >= 8 -->
		<!-- requires appropriate driver >= 8 -->
		<adapter-class mode="external"> de.jose.db.MySQLAdapter </adapter-class>
		<driver-class> com.mysql.cj.jdbc.Driver </driver-class>
		<class-path>mysql-connector-java-8.0.27.jar</class-path>
		<jdbc-url> jdbc:mysql://database-1.c5aiy8siq0e5.eu-central-1.rds.amazonaws.com:3306/jose </jdbc-url>
		<!-- insert actual host name or IP address	-->
		<!-- insert port number, unless default -->

		<!-- insert user name -->
		<connection-param>
			<param-name> user </param-name>
			<param-value> jose </param-value>
		</connection-param>

		<!-- insert password (if required) -->
		<connection-param>
			<param-name> password </param-name>
			<param-value> capablanca </param-value>
		</connection-param>

		<!-- transactions are supported but not required	-->
		<connection-param>
			<param-name> relaxAutocommit</param-name>
			<param-value> true </param-value>
		</connection-param>

		<!-- use Unicode ? (not really efficient) -->
		<connection-param>
			<param-name> useUnicode </param-name>
			<param-value> false </param-value>
		</connection-param>

		<!-- for debugging only: -->
		<connection-param>
			<param-name> profileSql </param-name>
			<param-value> false </param-value>
		</connection-param>
	</data-source>

	<data-source default="false">
		<display-name> MySQL-aws2 </display-name>
		<jndi-name> jdbc/mysql-aws2 </jndi-name>
		<!-- runs MySQL >= 8 -->
		<!-- requires appropriate driver >= 8 -->
		<adapter-class mode="external"> de.jose.db.MySQLAdapter </adapter-class>
		<driver-class> com.mysql.jdbc.Driver </driver-class>
		<class-path>mysql.jar</class-path>
		<jdbc-url> jdbc:mysql://3.65.11.92:3306/jose </jdbc-url>
		<!-- insert actual host name or IP address	-->
		<!-- insert port number, unless default -->

		<!-- transactions are supported but not required	-->
		<connection-param>
			<param-name> relaxAutocommit</param-name>
			<param-value> true </param-value>
		</connection-param>

		<!-- use Unicode ? (not really efficient) -->
		<connection-param>
			<param-name> useUnicode </param-name>
			<param-value> false </param-value>
		</connection-param>

		<!-- for debugging only: -->
		<connection-param>
			<param-name> profileSql </param-name>
			<param-value> false </param-value>
		</connection-param>
	</data-source>

	<data-source default="false">
		<display-name> Maria-local </display-name>
		<jndi-name> jdbc/maria-local </jndi-name>
		<!-- runs MariaDB 10.5 -->
		<adapter-class mode="external"> de.jose.db.MySQLAdapter </adapter-class>
		<driver-class> org.mariadb.jdbc.Driver </driver-class>
		<class-path>mariadb-java-client-3.5.3.jar</class-path>
		<jdbc-url> jdbc:mariadb://localhost:3306/jose </jdbc-url>
		<!-- insert actual host name or IP address	-->
		<!-- insert port number, unless default -->

		<!-- insert user name -->
		<connection-param>
			<param-name> user </param-name>
			<param-value> root </param-value>
		</connection-param>

		<!-- insert password (if required) -->
		<connection-param>
			<param-name> password </param-name>
			<param-value> jose </param-value>
		</connection-param>

		<!-- transactions are supported but not required	-->
		<connection-param>
			<param-name> relaxAutocommit</param-name>
			<param-value> true </param-value>
		</connection-param>

		<!-- use Unicode ? (not really efficient) -->
		<connection-param>
			<param-name> useUnicode </param-name>
			<param-value> false </param-value>
		</connection-param>

		<!-- for debugging only: -->
		<connection-param>
			<param-name> profileSql </param-name>
			<param-value> false </param-value>
		</connection-param>
	</data-source>


	<!-- MySQL separate server process -->
	<data-source default="true">
		<display-name> Maria-standalone </display-name>
		<jndi-name> jdbc/maria-standalone </jndi-name>
		<adapter-class mode="standalone"> de.jose.db.MariaDBAdapter </adapter-class>
		<driver-class> org.mariadb.jdbc.Driver </driver-class>
		<class-path> mariadb-java-client-3.5.3.jar </class-path>
		<jdbc-url> jdbc:mariadb://localhost:3306/jose </jdbc-url>
		<!-- this argument is ignored by MySQLAdapter when running as embedded server -->

		<!-- insert user name -->
		<connection-param>
			<param-name> user </param-name>
			<param-value> schaefer </param-value>
		</connection-param>

		<!-- insert password (if required) -->
		<connection-param>
			<param-name> password </param-name>
			<param-value> jose </param-value>
		</connection-param>

		<connection-param>
			<param-name>useServerPrepStmts</param-name>
			<param-value>true</param-value>
		</connection-param>

		<!-- transactions are supported but not required	-->
		<connection-param>
			<param-name> relaxAutocommit</param-name>
			<param-value> true </param-value>
		</connection-param>

		<!-- use Unicode ? (not really efficient) -->
		<connection-param>
			<param-name> useUnicode </param-name>
			<param-value> false </param-value>
		</connection-param>

		<connection-param>
			<param-name>useNewIO</param-name>
			<param-value>false</param-value>
		</connection-param>

		<!-- for debugging only: -->
		<connection-param>
			<param-name> profileSql </param-name>
			<param-value> false </param-value>
		</connection-param>

		<!-- UNIX only: path to socket file; make sure that ordinary users have access to it !!
			note that users usually don't have access to the default /var/lib/mysql/mysql.sock
		-->
		<!-- (comment out to revert to TCP/IP)
		<connection-param>
			<param-name> socket-file </param-name>
			<param-value> /tmp/mysql.jose.sock </param-value>
		</connection-param>
		-->

		<!-- Windows 2000/XP: named pipes -->
		<!-- (comment out to revert to TCP/IP) -->
		<!--
                <connection-param>
                    <param-name> pipe-name </param-name>
                    <param-value> mysql.jose </param-value>
                </connection-param>
        -->

	</data-source>


</data-sources>
